@@ -85 +96,4 @@
-CURL_OPTS="--resolve api.spotify.com:443:5.175.161.40 --resolve accounts.spotify.com:443:5.175.161.40 -s"
+# Web API refuses RU IPs: go through our own VPN (moviebot-xray relay on the NAS)
+CURL_OPTS="-s -m 10 --socks5-hostname 192.168.8.111:10808"
+JQ=/opt/bin/jq
+GAWK=/opt/bin/gawk
@@ -86,0 +101,103 @@
+SAY=/data/opt/media/bin/alice-say
+
+# Alice says what she is about to play (her own voice, cloud TTS). The voice
+# bridge doesn't cancel Alice while /tmp/soloist-say exists.
+say() {
+    [ -x "$SAY" ] && [ -n "$1" ] || return 0
+    echo "[search] say: $1" >> "$LOG"
+    : > /tmp/soloist-say
+    "$SAY" "$1" >/dev/null 2>&1 &     # in the background: don't hold up the music
+    ( sleep $(( 3 + ${#1} / 20 )); rm -f /tmp/soloist-say ) &
+}
+
+# play_uri URI [announcement]
+play_uri() {
+    echo "[search] SUCCESS: Found URI '$1' -> sending to Soloist" >> "$LOG"
+    say "$2"
+    run_soloist ctl -w 127.0.0.1:9090 activate >/dev/null 2>&1 || true
+    run_soloist ctl -w 127.0.0.1:9090 play "$1"
+    exit 0
+}
+
+# Access token on behalf of the user (read-only playlist scopes), from the
+# REFRESH_TOKEN saved by the one-time login
+user_token() {
+    [ -n "$REFRESH_TOKEN" ] || return 1
+    now=$(date +%s)
+    if [ -f /tmp/spotify_user_token_exp ] && [ "$now" -lt "$(cat /tmp/spotify_user_token_exp)" ]; then
+        cat /tmp/spotify_user_token
+        return 0
+    fi
+    ut=$($CURL_BIN $CURL_OPTS -X POST "https://accounts.spotify.com/api/token" \
+        -u "$SPOTIFY_CLIENT_ID:$SPOTIFY_CLIENT_SECRET" \
+        -d grant_type=refresh_token --data-urlencode "refresh_token=$REFRESH_TOKEN" | $JQ -r '.access_token // empty')
+    [ -n "$ut" ] || return 1
+    (umask 077; echo "$ut" > /tmp/spotify_user_token; echo $((now + 3300)) > /tmp/spotify_user_token_exp)
+    echo "$ut"
+}
+
+# "мои лайки": Liked Songs of the account Soloist is logged in with
+if [ "$TYPE" = "liked" ]; then
+    SPOTIFY_USER=$(grep -o "logged in as [A-Za-z0-9]*" /tmp/soloist.log 2>/dev/null | tail -1 | cut -d" " -f4)
+    if [ -n "$SPOTIFY_USER" ]; then
+        echo "$SPOTIFY_USER" > "$BASE_DIR/data/user_id"
+    else
+        SPOTIFY_USER=$(cat "$BASE_DIR/data/user_id" 2>/dev/null)
+    fi
+    if [ -n "$SPOTIFY_USER" ]; then
+        # in order, newest first: shuffle would start from a random liked track.
+        # Shuffle only sticks on an active device and before the context loads.
+        run_soloist ctl -w 127.0.0.1:9090 activate >/dev/null 2>&1
+        run_soloist ctl -w 127.0.0.1:9090 shuffle off >/dev/null 2>&1
+        sleep 0.5
+        play_uri "spotify:user:$SPOTIFY_USER:collection" "Включаю ваши любимые треки"
+    fi
+    echo "[search] Liked songs: Soloist user id not found, falling back to search" >> "$LOG"
+    TYPE="track"
+fi
+
+# "плейлист <name>": best name match among the user's own playlists, then public ones
+if [ "$TYPE" = "playlist" ]; then
+    UT=$(user_token)
+    if [ -n "$UT" ]; then
+        # the playlist list is cached for an hour: fetching 200+ playlists takes seconds
+        LIST=""
+        OFF=500
+        FETCHED=0
+        if [ -s /tmp/spotify_playlists ] && [ $(( $(date +%s) - $(date -r /tmp/spotify_playlists +%s) )) -lt 3600 ]; then
+            LIST=$(cat /tmp/spotify_playlists)
+        else
+            OFF=0
+            FETCHED=1
+        fi
+        while [ $OFF -lt 500 ]; do
+            PAGE=$($CURL_BIN $CURL_OPTS "https://api.spotify.com/v1/me/playlists?limit=50&offset=$OFF" \
+                -H "Authorization: Bearer $UT")
+            ROWS=$(printf '%s' "$PAGE" | $JQ -r '.items[]? | select(. != null) | [.uri, .name] | @tsv')
+            [ -n "$ROWS" ] || break
+            LIST="$LIST$ROWS
+"
+            [ -n "$(printf '%s' "$PAGE" | $JQ -r '.next // empty')" ] || break
+            OFF=$((OFF + 50))
+        done
+        [ "$FETCHED" = 1 ] && [ -n "$LIST" ] && printf '%s\n' "$LIST" > /tmp/spotify_playlists
+        URI=$(printf '%s' "$LIST" | SEARCH_TERM="$TERM" LC_ALL=ru_RU.UTF-8 $GAWK -F'\t' '
+            BEGIN { q = tolower(ENVIRON["SEARCH_TERM"]); n = split(q, w, " ") }
+            NF >= 2 {
+                name = tolower($2); s = 0
+                if (name == q) s = 100
+                else if (index(name, q)) s = 50
+                for (i = 1; i <= n; i++) if (length(w[i]) > 1 && index(name, w[i])) s += 5
+                if (s > best) { best = s; uri = $1 }
+            }
+            END { if (best > 0) print uri }')
+        if [ -n "$URI" ]; then
+            PNAME=$(printf '%s\n' "$LIST" | awk -F'\t' -v u="$URI" '$1 == u { print $2; exit }')
+            play_uri "$URI" "Включаю ваш плейлист «$PNAME»"
+        fi
+        echo "[search] No own playlist matches '$TERM', searching public playlists" >> "$LOG"
+    else
+        echo "[search] No user token (REFRESH_TOKEN missing?), searching public playlists" >> "$LOG"
+    fi
+fi
+
@@ -211,3 +328,8 @@
-    echo "[search] SUCCESS: Found URI '$URI' -> sending to Soloist" >> "$LOG"
-    run_soloist ctl -w 127.0.0.1:9090 activate >/dev/null 2>&1 || true
-    run_soloist ctl -w 127.0.0.1:9090 play "$URI"
+    # what Alice says: "Кино, «Звезда по имени Солнце»", artist, or album
+    WHAT=$(printf '%s' "$SEARCH_RESP" | $JQ -r --arg u "$URI" '
+        [ (.tracks.items[]?  | select(.uri == $u) | "\(.artists[0].name), «\(.name)»"),
+          (.artists.items[]? | select(.uri == $u) | .name),
+          (.albums.items[]?  | select(.uri == $u) | "альбом «\(.name)», \(.artists[0].name)"),
+          (.playlists.items[]? | select(. != null and .uri == $u) | "плейлист «\(.name)»") ]
+        | first // empty' 2>/dev/null)
+    play_uri "$URI" "Включаю${WHAT:+: $WHAT}"
